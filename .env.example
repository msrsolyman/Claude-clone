# Environment Configuration for Atelier
# Copy this file to .env.local and populate your secrets

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/atelier_db

# Authentication (NextAuth / Supabase)
AUTH_SECRET=your-32-character-secret-key-goes-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Model Providers (Official Public APIs)
# Required if you want to call real LLMs instead of local simulation
LLM_PROVIDER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Payments (Stripe Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Transactional Email (Resend)
RESEND_API_KEY=re_placeholder
EMAIL_FROM=notifications@yourdomain.com

# File Storage Limits
MAX_UPLOAD_SIZE_MB=25
